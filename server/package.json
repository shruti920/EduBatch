{
  "name": "edubatch-server",
  "version": "1.0.0",
  "private": true,
  "description": "EduBatch REST API \u2014 Express, MongoDB, JWT",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seedUsers.js && node src/scripts/seedBatches.js && node src/scripts/seedEnrollments.js && node src/scripts/seedAttendance.js",
    "test": "node src/scripts/runTests.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "nodemailer": "^10.0.10",
    "razorpay": "^2.9.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
