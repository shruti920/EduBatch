# Copy to .env and fill in. Never commit the real .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/edubatch

# Optional: separate database for `npm test` (seeded automatically), keeps demo data clean
MONGO_URI_TEST=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/edubatch_test

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173

# Used to decide what "today" is for attendance
APP_TIMEZONE=Asia/Kolkata

# Razorpay TEST keys: Dashboard → Account & Settings → API keys (Test mode).
# Never commit real keys. Without these, the app works but "Pay now" is disabled.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Optional but recommended: Dashboard → Webhooks → Add (URL: <API URL>/api/v1/payments/webhook,
# events: payment.captured, payment.failed, order.paid). You choose this secret there.
RAZORPAY_WEBHOOK_SECRET=choose_a_webhook_secret
