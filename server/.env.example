# Copy to .env and fill in. Never commit the real .env.
PORT=5000
NODE_ENV=development

# ---------- Database ----------
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/edubatch
# Optional: separate database for `npm test` (seeded automatically), keeps demo data clean
MONGO_URI_TEST=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/edubatch_test

# ---------- Auth ----------
# Long random string (production requires 32+ chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# Access token lifetime. Short on purpose; the refresh cookie keeps people signed in.
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token (httpOnly cookie) lifetime in days
REFRESH_TOKEN_TTL_DAYS=7
# "lax" when the frontend reaches the API on the same site (Vite proxy / Vercel rewrite — recommended).
# Use "none" only if the browser calls the Render URL directly from another domain.
COOKIE_SAMESITE=lax
# Password reset link lifetime
PASSWORD_RESET_TTL_MINUTES=15
# Shared demo logins: their password can't be changed/reset and they can't be deactivated,
# so one reviewer can't lock the others out. Comma-separated.
DEMO_PROTECTED_EMAILS=admin@edubatch.com,teacher@edubatch.com,student@edubatch.com

# ---------- URLs ----------
# Frontend origin(s) allowed by CORS, comma-separated (required in production; no localhost there)
CLIENT_URL=http://localhost:5173
# Public frontend URL used in email links (required in production)
APP_URL=http://localhost:5173
# Proxies in front of the API, so rate limits see the real client IP.
# Local: 1. Render: 1. Render behind the Vercel /api rewrite: 2.
TRUST_PROXY_HOPS=1

# Used to decide what "today" is for attendance and upcoming classes
APP_TIMEZONE=Asia/Kolkata

# ---------- Email (Nodemailer / SMTP) ----------
# Leave SMTP_HOST empty to log emails to the console instead of sending them.
# Local dev with Gmail: smtp.gmail.com, port 587, your address, and a 16-char App Password
#   (Google Account → Security → 2-Step Verification → App passwords).
# Render FREE tier blocks ports 25/465/587 — use Brevo on port 2525 there:
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=2525  SMTP_USER=<Brevo SMTP login>  SMTP_PASS=<Brevo SMTP key>
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); leave empty/false for 587 and 2525 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Must be a sender your SMTP provider has verified
EMAIL_FROM="EduBatch <your-verified-sender@example.com>"

# ---------- Razorpay (TEST mode) ----------
# Dashboard → Account & Settings → API keys (Test mode). Required in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
# Optional but recommended: Dashboard → Webhooks → Add (URL: <API URL>/api/v1/payments/webhook,
# events: payment.captured, payment.failed, order.paid). You choose this secret there.
RAZORPAY_WEBHOOK_SECRET=choose_a_webhook_secret
