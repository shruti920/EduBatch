# Base URL of the EduBatch API, including /api/v1.
# Keep the default "/api/v1": in dev the Vite proxy forwards it to localhost:5000,
# in production vercel.json rewrites it to your Render service. Same-origin API calls
# keep the httpOnly refresh cookie first-party (Safari/Firefox block third-party cookies).
VITE_API_URL=/api/v1
